# Supabase project URL and service_role key (Project Settings -> API)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key

# Comma-separated list of allowed frontend origins (CORS)
FRONTEND_URL=http://localhost:5173,https://your-frontend-domain.com

# Railway sets PORT automatically; local default below
PORT=4000
